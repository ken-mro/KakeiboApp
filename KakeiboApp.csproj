<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- net10.0 (no platform) is only built so KakeiboApp.Tests can reference the app's code. Keep it last so it is never the default debug target. -->
		<TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
		<!-- The net10.0 build only lends its code to KakeiboApp.Tests and never runs, so platform-only APIs (CA1416) are fine there. -->
		<NoWarn Condition="'$(TargetFramework)' == 'net10.0'">$(NoWarn);CA1416</NoWarn>
		<RootNamespace>KakeiboApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>家計簿</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.kakeiboapp</ApplicationId>
		<!-- The App Store needs a bundle ID of our own. Only iOS has it: a new ID on Android would be a new app,
		     and the installed one could not be updated. -->
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">com.kenmro.kakeiboapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.11</ApplicationDisplayVersion>
		<ApplicationVersion>13</ApplicationVersion>
		<!-- MAUI copies ApplicationDisplayVersion into Version only for Android, iOS and Mac Catalyst, so net10.0 and Windows
		     stayed at 1.0.0. Visual Studio's restore needs one PackageVersion across all target frameworks (NU1105);
		     otherwise it reads no frameworks at all and every build fails with NETSDK1005. -->
		<Version>$(ApplicationDisplayVersion)</Version>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
		<DefaultItemExcludes>$(DefaultItemExcludes);KakeiboApp.Tests\**</DefaultItemExcludes>
	</PropertyGroup>

	<!-- The App Store build (docs/IOS_RELEASE.md): for devices, signed for distribution with the team's
	     certificate. The provisioning profile is chosen at publish time with -p:CodesignProvision. -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)' == 'Release|net10.0-ios'">
		<RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
		<CodesignKey>Apple Distribution</CodesignKey>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<!-- The piggy-bank mascot (appiconfg.svg) on AccentSoft lavender (appicon.svg). The scale keeps it inside the adaptive-icon safe zone. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' " Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#EFE8FF" BaseSize="128, 128" ForegroundScale="0.52" />
		<!-- iOS and Mac Catalyst: the same icon; their masks round the corners and need no safe zone, so the mascot can be larger. -->
		<MauiIcon Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#EFE8FF" BaseSize="128, 128" ForegroundScale="0.65" />

		<!-- Splash Screen -->
		<!-- The mascot on Paper (Resources/Styles/Colors.xaml), so the splash matches the first screen. -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF5F7" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
		<PackageReference Include="Plugin.Maui.Biometric" Version="0.1.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<PackageReference Include="Syncfusion.Maui.Inputs" Version="34.2.9" />
		<PackageReference Include="Syncfusion.Maui.Picker" Version="34.2.9" />
	</ItemGroup>

	<!-- MAUI 10.0.110 resolves newer AndroidX base packages than its *.Ktx packages accept (NU1608).
	     Pin the Ktx packages to the versions that match the resolved base packages. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="1.13.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.9.3" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.11.0.1" />
		<PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.5.0.1" />
	</ItemGroup>

</Project>
