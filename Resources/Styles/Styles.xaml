<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Styles for "ころんと、やさしい家計簿". Colours come only from the tokens in Colors.xaml
    (DynamicResource, so they follow the theme). Font families are registered in MauiProgram:
    ZenMaru (Regular), ZenMaruMedium, ZenMaruBold.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Type scale  -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="ZenMaru" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="ZenMaru" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="ZenMaruBold" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="LineHeight" Value="0.9" />
    </Style>

    <Style x:Key="Title" TargetType="Label">
        <Setter Property="FontFamily" Value="ZenMaruBold" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="ZenMaruBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!--  Amounts never break across lines; the text next to them wraps instead.  -->
    <Style x:Key="Amount" TargetType="Label">
        <Setter Property="FontFamily" Value="ZenMaruMedium" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="LabelText" TargetType="Label">
        <Setter Property="FontFamily" Value="ZenMaruMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
    </Style>

    <!--  What is wrong with a field, right under it  -->
    <Style x:Key="FieldError" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource DeficitInk}" />
    </Style>

    <!--  Surfaces  -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <!--  The pages draw their own header and Views/Controls/FloatingTabBar instead of Shell's bars.  -->
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Paper}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource Paper}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource Ink}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Stroke" Value="Transparent" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="20,18" />
    </Style>

    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Hero}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 28" />
        <Setter Property="Padding" Value="20,24,20,20" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 22" />
        <Setter Property="Padding" Value="18,12" />
    </Style>

    <Style x:Key="Field" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Paper}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <!--  Buttons: round, 56 high for the main action  -->
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="FontFamily" Value="ZenMaruBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="MinimumHeightRequest" Value="56" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource Track}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver" />
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource AccentInk}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="BorderColor" Value="{DynamicResource Accent}" />
        <Setter Property="BorderWidth" Value="2" />
    </Style>

    <Style x:Key="SmallOutlineButton" BasedOn="{StaticResource OutlineButton}" TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="18,0" />
    </Style>

    <Style x:Key="DeleteButton" BasedOn="{StaticResource OutlineButton}" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource DeficitInk}" />
        <Setter Property="BorderColor" Value="{DynamicResource Deficit}" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource AccentInk}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="ZenMaruMedium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="48" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--  Invisible button laid over composed content (Views/Controls/Pressable) so it is read as a button.  -->
    <Style x:Key="OverlayButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <!--  Stays invisible while its command runs (for example while a sheet it opened is shown).  -->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!--  Inputs  -->
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="ZenMaru" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style x:Key="AmountEntry" TargetType="Entry">
        <Setter Property="FontFamily" Value="ZenMaruBold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="Keyboard" Value="Numeric" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="ZenMaru" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="ZenMaru" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource AccentSoft}" />
        <Setter Property="ThumbColor" Value="{DynamicResource InkMuted}" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{DynamicResource Accent}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{DynamicResource InkMuted}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource Rule}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource Accent}" />
    </Style>

    <Style TargetType="SwipeView">
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

</ResourceDictionary>
