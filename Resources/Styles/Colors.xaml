<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Design tokens for "ころんと、やさしい家計簿" (docs/UI_REDESIGN_PLAN.md).
    Each theme-dependent token has a Light and a Dark value. ThemeTokens copies the pair for the
    current theme into the plain key (Ink, Paper, ...), so pages use {DynamicResource Ink} and follow
    theme changes without AppThemeBinding everywhere.
    The category colours (the same in both themes) are in Services/CategoryStyle.cs.
    For Android see also Platforms\Android\Resources\values\colors.xml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="InkLight">#4A3B52</Color>
    <Color x:Key="InkDark">#F8EEF6</Color>
    <Color x:Key="InkMutedLight">#75657E</Color>
    <Color x:Key="InkMutedDark">#C9B9D1</Color>
    <Color x:Key="PaperLight">#FFF5F7</Color>
    <Color x:Key="PaperDark">#231B2A</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#30263A</Color>
    <Color x:Key="HeroLight">#FFE6EE</Color>
    <Color x:Key="HeroDark">#3D2C44</Color>
    <Color x:Key="AccentLight">#7C5CC4</Color>
    <Color x:Key="AccentDark">#C7B3FF</Color>
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#2A2033</Color>
    <Color x:Key="AccentSoftLight">#EFE8FF</Color>
    <Color x:Key="AccentSoftDark">#3E3354</Color>
    <Color x:Key="AccentInkLight">#5F43A8</Color>
    <Color x:Key="AccentInkDark">#DCCFFF</Color>
    <Color x:Key="DeficitLight">#E0566F</Color>
    <Color x:Key="DeficitDark">#FF91A4</Color>
    <Color x:Key="DeficitInkLight">#A82A41</Color>
    <Color x:Key="DeficitInkDark">#FFB3C0</Color>
    <Color x:Key="DeficitSoftLight">#FFE4E8</Color>
    <Color x:Key="DeficitSoftDark">#4A2731</Color>
    <Color x:Key="RuleLight">#F3D9E2</Color>
    <Color x:Key="RuleDark">#4A3D55</Color>
    <Color x:Key="TrackLight">#F6E7EE</Color>
    <Color x:Key="TrackDark">#45384F</Color>
    <!-- Swipe-to-delete surface. White text on light Deficit is only 3.7:1, so light uses DeficitInk (6.8:1). -->
    <Color x:Key="DeleteSurfaceLight">#A82A41</Color>
    <Color x:Key="DeleteSurfaceDark">#FF91A4</Color>
    <Color x:Key="OnDeleteLight">#FFFFFF</Color>
    <Color x:Key="OnDeleteDark">#2A2033</Color>
    <!-- Undo toast. -->
    <Color x:Key="ToastLight">#4A3B52</Color>
    <Color x:Key="ToastDark">#F8EEF6</Color>
    <Color x:Key="OnToastLight">#FFFFFF</Color>
    <Color x:Key="OnToastDark">#2A2033</Color>
    <Color x:Key="ToastButtonLight">#5E4D68</Color>
    <Color x:Key="ToastButtonDark">#E3D8FF</Color>
    <Color x:Key="OnToastButtonLight">#E3D8FF</Color>
    <Color x:Key="OnToastButtonDark">#3E3354</Color>
    <!-- Dimmed page behind a sheet. -->
    <Color x:Key="ScrimLight">#6B4A3B52</Color>
    <Color x:Key="ScrimDark">#99000000</Color>
    <!--  The page around the part the guide explains: darker than a sheet's scrim so the hole stands out.  -->
    <Color x:Key="TourScrimLight">#994A3B52</Color>
    <Color x:Key="TourScrimDark">#B3000000</Color>

    <!-- Lavender shadow, only for the add button and the tab bar. -->
    <Color x:Key="ShadowLavender">#7C5CC4</Color>

</ResourceDictionary>
