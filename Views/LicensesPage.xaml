<?xml version="1.0" encoding="utf-8" ?>
<!--
    ライセンス: the libraries and the font the app uses, with their licenses (Resources/Raw/ThirdPartyNotices.txt),
    opened from 設定's このアプリについて.
-->
<ContentPage
    x:Class="KakeiboApp.Views.LicensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KakeiboApp.Views.Controls"
    xmlns:services="clr-namespace:KakeiboApp.Services">
    <Grid x:Name="root" RowDefinitions="Auto,*">
        <!--  ‹ and the title  -->
        <Grid
            Padding="16,20,16,8"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8">
            <controls:Pressable
                x:Name="back"
                CornerRadius="22"
                Description="設定に戻る">
                <Border
                    BackgroundColor="{DynamicResource Surface}"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    WidthRequest="44">
                    <controls:IconPath
                        Weight="2.4"
                        Color="{DynamicResource Ink}"
                        Glyph="{x:Static services:Icons.ChevronLeft}"
                        Size="18" />
                </Border>
            </controls:Pressable>
            <Label
                Grid.Column="1"
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Title}"
                Text="ライセンス"
                VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <Border
                Margin="16,8,16,32"
                Padding="20,16"
                Style="{StaticResource Card}">
                <VerticalStackLayout x:Name="body" Spacing="12" />
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
