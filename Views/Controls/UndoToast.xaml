<?xml version="1.0" encoding="utf-8" ?>
<!--  「〜をけしました ／ もとに戻す」. BindingContext is an UndoToastModel.  -->
<ContentView
    x:Class="KakeiboApp.Views.Controls.UndoToast"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KakeiboApp.ViewModels"
    x:DataType="vm:UndoToastModel"
    IsVisible="{Binding IsVisible}"
    VerticalOptions="End">
    <Border
        Padding="20,6,8,6"
        BackgroundColor="{DynamicResource Toast}"
        MinimumHeightRequest="56"
        StrokeShape="RoundRectangle 28">
        <Border.Shadow>
            <Shadow
                Brush="{StaticResource ShadowLavender}"
                Opacity="0.25"
                Radius="20"
                Offset="0,8" />
        </Border.Shadow>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label
                FontSize="14"
                LineBreakMode="WordWrap"
                Text="{Binding Message}"
                TextColor="{DynamicResource OnToast}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Padding="16,0"
                BackgroundColor="{DynamicResource ToastButton}"
                Command="{Binding UndoCommand}"
                CornerRadius="22"
                FontSize="14"
                HeightRequest="44"
                Text="もとに戻す"
                TextColor="{DynamicResource OnToastButton}"
                VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
