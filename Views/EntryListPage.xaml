<?xml version="1.0" encoding="utf-8" ?>
<!--  The shared list for every kind of entry (design: project/List.dc.html).  -->
<ContentPage
    x:Class="KakeiboApp.Views.EntryListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KakeiboApp.Views.Controls"
    xmlns:entries="clr-namespace:KakeiboApp.ViewModels.Entries"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:services="clr-namespace:KakeiboApp.Services"
    xmlns:views="clr-namespace:KakeiboApp.Views"
    x:Name="page"
    x:DataType="entries:EntryListViewModel">
    <ContentPage.Resources>
        <DataTemplate x:Key="PlainRow" x:DataType="entries:EntryRow">
            <Border BackgroundColor="{DynamicResource Surface}" StrokeShape="{Binding RowShape}">
                <controls:EntryRowView Command="{Binding Source={x:Reference page}, Path=BindingContext.EditCommand, x:DataType=ContentPage}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DeletableRow" x:DataType="entries:EntryRow">
            <Border BackgroundColor="{DynamicResource Surface}" StrokeShape="{Binding RowShape}">
                <SwipeView Threshold="92">
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                            <SwipeItemView
                                Command="{Binding Source={x:Reference page}, Path=BindingContext.DeleteCommand, x:DataType=ContentPage}"
                                CommandParameter="{Binding .}"
                                SemanticProperties.Description="{Binding DeleteLabel}">
                                <Grid BackgroundColor="{DynamicResource DeleteSurface}" WidthRequest="92">
                                    <VerticalStackLayout
                                        HorizontalOptions="Center"
                                        Spacing="2"
                                        VerticalOptions="Center">
                                        <controls:IconPath
                                            Weight="2.2"
                                            Color="{DynamicResource OnDelete}"
                                            Glyph="{x:Static services:Icons.Trash}"
                                            Size="20" />
                                        <Label
                                            FontFamily="ZenMaruBold"
                                            FontSize="14"
                                            HorizontalTextAlignment="Center"
                                            Text="けす"
                                            TextColor="{DynamicResource OnDelete}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </SwipeItemView>
                        </SwipeItems>
                    </SwipeView.RightItems>
                    <controls:EntryRowView Command="{Binding Source={x:Reference page}, Path=BindingContext.EditCommand, x:DataType=ContentPage}" />
                </SwipeView>
            </Border>
        </DataTemplate>
        <views:EntryRowTemplateSelector
            x:Key="RowTemplates"
            Deletable="{StaticResource DeletableRow}"
            Plain="{StaticResource PlainRow}" />
    </ContentPage.Resources>

    <Grid x:Name="root">
        <Grid RowDefinitions="Auto,*">
            <!--  The title, the month (or year) arrows and the search stay at the top while the list scrolls.
                 The search field is outside the list too, so typing is not interrupted when the rows change.  -->
            <VerticalStackLayout Padding="16,20,16,8">
                <!--  Opened from the home: back button and title  -->
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsPushed}">
                    <controls:Pressable
                        Command="{Binding BackCommand}"
                        CornerRadius="22"
                        Description="ホームに戻る">
                        <Border
                            BackgroundColor="{DynamicResource Surface}"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44">
                            <controls:IconPath
                                Weight="2.4"
                                Color="{DynamicResource Ink}"
                                Glyph="{x:Static services:Icons.ChevronLeft}"
                                Size="18" />
                        </Border>
                    </controls:Pressable>
                    <FlexLayout
                        Grid.Column="1"
                        AlignItems="Center"
                        JustifyContent="Start"
                        VerticalOptions="Center"
                        Wrap="Wrap">
                        <Label
                            LineBreakMode="NoWrap"
                            SemanticProperties.Description="{Binding Title}"
                            SemanticProperties.HeadingLevel="Level1"
                            Style="{StaticResource Title}"
                            Text="{Binding TitleLead}" />
                        <Label
                            AutomationProperties.IsInAccessibleTree="False"
                            LineBreakMode="NoWrap"
                            Style="{StaticResource Title}"
                            Text="{Binding TitleTail}" />
                    </FlexLayout>
                </Grid>
                <!--  A tab: month (or year) arrows around the title, and the search button  -->
                <Grid
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsBrowsing}">
                    <controls:Pressable
                        Command="{Binding PreviousCommand}"
                        CornerRadius="22"
                        Description="{Binding PreviousDescription}">
                        <Border
                            BackgroundColor="{DynamicResource Surface}"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44">
                            <controls:IconPath
                                Weight="2.4"
                                Color="{DynamicResource Ink}"
                                Glyph="{x:Static services:Icons.ChevronLeft}"
                                Size="18" />
                        </Border>
                    </controls:Pressable>
                    <FlexLayout
                        Grid.Column="1"
                        AlignItems="Center"
                        JustifyContent="Center"
                        VerticalOptions="Center"
                        Wrap="Wrap">
                        <Label
                            LineBreakMode="NoWrap"
                            SemanticProperties.Description="{Binding Title}"
                            SemanticProperties.HeadingLevel="Level1"
                            Style="{StaticResource Title}"
                            Text="{Binding TitleLead}" />
                        <Label
                            AutomationProperties.IsInAccessibleTree="False"
                            LineBreakMode="NoWrap"
                            Style="{StaticResource Title}"
                            Text="{Binding TitleTail}" />
                    </FlexLayout>
                    <controls:Pressable
                        Grid.Column="2"
                        Command="{Binding NextCommand}"
                        CornerRadius="22"
                        Description="{Binding NextDescription}">
                        <Border
                            BackgroundColor="{DynamicResource Surface}"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44">
                            <controls:IconPath
                                Weight="2.4"
                                Color="{DynamicResource Ink}"
                                Glyph="{x:Static services:Icons.ChevronRight}"
                                Size="18" />
                        </Border>
                    </controls:Pressable>
                    <controls:Pressable
                        x:Name="searchButton"
                        Grid.Column="3"
                        Command="{Binding OpenSearchCommand}"
                        CornerRadius="22"
                        Description="{Binding SearchDescription}"
                        IsVisible="{Binding CanSearch}">
                        <Border
                            BackgroundColor="{DynamicResource AccentSoft}"
                            HeightRequest="44"
                            StrokeShape="RoundRectangle 22"
                            WidthRequest="44">
                            <controls:IconPath
                                Weight="2.4"
                                Color="{DynamicResource AccentInk}"
                                Glyph="{x:Static services:Icons.Search}"
                                Size="18" />
                        </Border>
                    </controls:Pressable>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding IsSearching}" Spacing="10">
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="4">
                    <Border
                        Padding="16,0,8,0"
                        BackgroundColor="{DynamicResource Surface}"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 24">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <controls:IconPath
                                Weight="2.4"
                                Color="{DynamicResource InkMuted}"
                                Glyph="{x:Static services:Icons.Search}"
                                Size="18" />
                            <Entry
                                x:Name="searchEntry"
                                Grid.Column="1"
                                ClearButtonVisibility="WhileEditing"
                                Placeholder="{Binding SearchPlaceholder}"
                                ReturnType="Search"
                                SemanticProperties.Description="{Binding Title}"
                                SemanticProperties.Hint="{Binding SearchPlaceholder}"
                                Text="{Binding SearchText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Button
                        Grid.Column="1"
                        Command="{Binding CloseSearchCommand}"
                        Style="{StaticResource TextButton}"
                        Text="とじる" />
                </Grid>
                <!--  The period: すべて, 今月, 先月, 今年, or two dates  -->
                <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Periods}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="entries:PeriodChip">
                                <controls:Pressable
                                    Command="{Binding Source={x:Reference page}, Path=BindingContext.SelectPeriodCommand, x:DataType=ContentPage}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="20"
                                    Description="{Binding Description}">
                                    <Border
                                        Padding="13,0"
                                        BackgroundColor="{DynamicResource Surface}"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        StrokeThickness="0">
                                        <Border.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Border"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label
                                            FontSize="14"
                                            Text="{Binding Label}"
                                            TextColor="{DynamicResource Ink}"
                                            VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSelected}"
                                                    TargetType="Label"
                                                    Value="True">
                                                    <Setter Property="TextColor" Value="{DynamicResource AccentInk}" />
                                                    <Setter Property="FontFamily" Value="ZenMaruBold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>
                                </controls:Pressable>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
                <Grid
                    ColumnDefinitions="*,Auto,*"
                    ColumnSpacing="8"
                    IsVisible="{Binding IsCustomPeriod}">
                    <Border BackgroundColor="{DynamicResource Surface}" Style="{StaticResource Field}">
                        <DatePicker
                            Date="{Binding PeriodFrom}"
                            Format="yyyy/MM/dd"
                            MaximumDate="{x:Static entries:EntrySheetViewModel.MaximumDate}"
                            MinimumDate="{x:Static entries:EntrySheetViewModel.MinimumDate}"
                            SemanticProperties.Description="いつから" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        Text="〜"
                        VerticalOptions="Center"
                        AutomationProperties.IsInAccessibleTree="False" />
                    <Border
                        Grid.Column="2"
                        BackgroundColor="{DynamicResource Surface}"
                        Style="{StaticResource Field}">
                        <DatePicker
                            Date="{Binding PeriodTo}"
                            Format="yyyy/MM/dd"
                            MaximumDate="{x:Static entries:EntrySheetViewModel.MaximumDate}"
                            MinimumDate="{x:Static entries:EntrySheetViewModel.MinimumDate}"
                            SemanticProperties.Description="いつまで" />
                    </Border>
                </Grid>
                <!--  生活費: the kinds, as many as wanted (none is every kind), in a dropdown like the entry sheet's 種類  -->
                <Border
                    BackgroundColor="{DynamicResource Surface}"
                    IsVisible="{Binding CanFilterCategories}"
                    Style="{StaticResource Field}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label
                            Style="{StaticResource Muted}"
                            Text="種類"
                            VerticalOptions="Center"
                            AutomationProperties.IsInAccessibleTree="False" />
                        <inputs:SfComboBox
                            x:Name="categoryPicker"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            DelimiterText="・"
                            DisplayMemberPath="Name"
                            DropDownBackground="{DynamicResource Surface}"
                            DropDownCornerRadius="16"
                            DropDownIconColor="{DynamicResource InkMuted}"
                            DropDownItemHeight="48"
                            DropDownPlacement="Bottom"
                            DropDownStroke="{DynamicResource Rule}"
                            FontFamily="ZenMaru"
                            FontSize="15"
                            IsClearButtonVisible="False"
                            IsEditable="False"
                            ItemsSource="{Binding CategoryChips}"
                            MaxDropDownHeight="360"
                            MinimumHeightRequest="44"
                            MultiSelectionDisplayMode="Delimiter"
                            Placeholder="すべての種類"
                            PlaceholderColor="{DynamicResource Ink}"
                            SelectedDropDownItemBackground="{DynamicResource AccentSoft}"
                            SelectionMode="Multiple"
                            SemanticProperties.Description="種類"
                            ShowBorder="False"
                            TextColor="{DynamicResource Ink}">
                            <inputs:SfComboBox.ItemTemplate>
                                <DataTemplate x:DataType="entries:CategoryOption">
                                    <Grid Padding="14,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <controls:IconChip
                                            BackgroundColor="{Binding Style.Chip}"
                                            Diameter="28"
                                            Glyph="{Binding Style.Glyph}"
                                            IconColor="{Binding Style.Icon}"
                                            IconSize="16"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="16"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource Ink}"
                                            VerticalOptions="Center" />
                                        <controls:IconPath
                                            Grid.Column="2"
                                            IsVisible="{Binding IsSelected}"
                                            Weight="2.6"
                                            Color="{DynamicResource AccentInk}"
                                            Glyph="{x:Static services:Icons.Check}"
                                            Size="18"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </inputs:SfComboBox.ItemTemplate>
                        </inputs:SfComboBox>
                    </Grid>
                </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <CollectionView
                x:Name="list"
                Grid.Row="1"
                IsVisible="{Binding HasRows}"
                Margin="16,0"
                IsGrouped="True"
                ItemTemplate="{StaticResource RowTemplates}"
                ItemsSource="{Binding Groups}"
                SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,8,0,8" Spacing="16">
                        <!--  12件 / 合計 ¥210,000  -->
                        <Border
                            IsVisible="{Binding HasRows}"
                            SemanticProperties.Description="{Binding SummaryDescription}"
                            Style="{StaticResource Pill}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Style="{StaticResource Muted}"
                                    Text="{Binding CountText}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    LineBreakMode="NoWrap"
                                    VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span
                                                FontSize="14"
                                                Text="{Binding TotalLabel}"
                                                TextColor="{DynamicResource InkMuted}" />
                                            <Span Text=" " />
                                            <Span
                                                TextColor="{Binding TotalColor}"
                                                FontFamily="ZenMaruBold"
                                                FontSize="20"
                                                Text="{Binding TotalText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>

                        <Label
                            x:Name="hintLabel"
                            Margin="8,0"
                            IsVisible="{Binding HasNote}"
                            Style="{StaticResource Caption}"
                            Text="{Binding NoteText}" />

                        <!--  切り崩し: the month's 残りのお金, to see how much to withdraw  -->
                        <Border
                            IsVisible="{Binding HasMonthRemaining}"
                            SemanticProperties.Description="{Binding MonthRemainingDescription}"
                            Style="{StaticResource Pill}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" AutomationProperties.ExcludedWithChildren="True">
                                <Label
                                    Style="{StaticResource Muted}"
                                    Text="{Binding MonthRemainingLabel}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="ZenMaruBold"
                                    FontSize="20"
                                    Text="{Binding MonthRemainingText}"
                                    TextColor="{Binding MonthRemainingColor}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border IsVisible="{Binding HasRemainingUntilPreviousMonth}" Style="{StaticResource Pill}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label
                                    Style="{StaticResource Muted}"
                                    Text="先月までに残ったお金（貯金を除く）"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="ZenMaruBold"
                                    Text="{Binding RemainingUntilPreviousMonthText}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="entries:EntryGroup">
                        <Label
                            Margin="{Binding HeaderMargin}"
                            HeightRequest="{Binding HeaderHeight}"
                            FontFamily="ZenMaruMedium"
                            FontSize="13"
                            IsVisible="{Binding HasHeader}"
                            SemanticProperties.HeadingLevel="Level2"
                            Text="{Binding Header}"
                            TextColor="{DynamicResource InkMuted}" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,16,0,0">
                        <Button
                            Command="{Binding CopyPreviousCommand}"
                            HorizontalOptions="Start"
                            IsVisible="{Binding ShowsCopyPreviousLink}"
                            Style="{StaticResource TextButton}"
                            Text="{Binding CopyPreviousLinkText}" />
                        <!--  Room for the add button and the tab bar  -->
                        <BoxView HeightRequest="180" Color="Transparent" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
            <!--
                An empty list. Not the CollectionView's EmptyView: that is measured once, and a card that shows later
                (the copy card, once the previous month is counted) or text that wraps to more lines was cut off.
            -->
            <ScrollView
                Grid.Row="1"
                Margin="16,0"
                IsVisible="{Binding IsEmpty}">
                <VerticalStackLayout Padding="0,8,0,0" Spacing="16">
                    <!--  What the list's header says above the rows when it has no rows: the 特別出費 note, 先月までに残ったお金  -->
                    <Label
                        Margin="8,0"
                        IsVisible="{Binding HasNote}"
                        Style="{StaticResource Caption}"
                        Text="{Binding NoteText}" />
                    <!--  切り崩し: the month's 残りのお金, to see how much to withdraw  -->
                    <Border
                        IsVisible="{Binding HasMonthRemaining}"
                        SemanticProperties.Description="{Binding MonthRemainingDescription}"
                        Style="{StaticResource Pill}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" AutomationProperties.ExcludedWithChildren="True">
                            <Label
                                Style="{StaticResource Muted}"
                                Text="{Binding MonthRemainingLabel}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="ZenMaruBold"
                                FontSize="20"
                                Text="{Binding MonthRemainingText}"
                                TextColor="{Binding MonthRemainingColor}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding HasRemainingUntilPreviousMonth}" Style="{StaticResource Pill}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label
                                Style="{StaticResource Muted}"
                                Text="先月までに残ったお金（貯金を除く）"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="ZenMaruBold"
                                Text="{Binding RemainingUntilPreviousMonthText}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Padding="24,28" Style="{StaticResource Card}">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                            <Border
                                BackgroundColor="{DynamicResource Hero}"
                                HeightRequest="112"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 56"
                                WidthRequest="112">
                                <Image
                                    HeightRequest="80"
                                    SemanticProperties.Description="眠っているぶたの貯金箱"
                                    Source="pig_sleeping.png"
                                    WidthRequest="80" />
                            </Border>
                            <Label
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                LineHeight="1.15"
                                Text="{Binding EmptyText}"
                                TextColor="{DynamicResource InkMuted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border IsVisible="{Binding CanCopyPrevious}" Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <controls:IconChip
                                BackgroundColor="{DynamicResource AccentSoft}"
                                Diameter="44"
                                Glyph="{Binding KindGlyph}"
                                IconColor="{DynamicResource AccentInk}"
                                VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label FontSize="14" Text="{Binding CopyPreviousText}" />
                                <Button
                                    Command="{Binding CopyPreviousCommand}"
                                    HorizontalOptions="Start"
                                    Style="{StaticResource SmallOutlineButton}"
                                    Text="{Binding CopyPreviousButtonText}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!--  Room for the add button and the tab bar  -->
                    <BoxView HeightRequest="180" Color="Transparent" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <controls:UndoToast
            x:Name="undoToast"
            Margin="16,0,16,96"
            BindingContext="{Binding Undo}" />

        <controls:FloatingTabBar x:Name="tabBar" />

        <!--  ＋ つける, as on every page; lower on a page opened from the home, which has no tab bar (EntryListPage.xaml.cs)  -->
        <controls:QuickAddButton
            x:Name="quickAdd"
            FabMargin="0,0,20,112"
            IsVisible="{Binding ShowsAdd}" />
    </Grid>
</ContentPage>
