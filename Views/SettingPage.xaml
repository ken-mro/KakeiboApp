<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KakeiboApp.Views.SettingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KakeiboApp.Views.Controls"
    xmlns:services="clr-namespace:KakeiboApp.Services"
    xmlns:viewmodels="clr-namespace:KakeiboApp.ViewModels"
    x:Name="page"
    x:DataType="viewmodels:SettingPageViewModel">
    <Grid x:Name="root">
        <ScrollView x:Name="scroll">
            <VerticalStackLayout Padding="16,20,16,0" Spacing="16">
                <Label
                    Margin="4,10,0,0"
                    SemanticProperties.HeadingLevel="Level1"
                    Style="{StaticResource Title}"
                    Text="設定" />

                <!--  テーマ  -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            SemanticProperties.HeadingLevel="Level2"
                            Style="{StaticResource Heading}"
                            Text="テーマ" />
                        <Grid
                            x:Name="themes"
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="8" />
                    </VerticalStackLayout>
                </Border>

                <!--  認証・ホーム  -->
                <Border Padding="20,8" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            MinimumHeightRequest="64">
                            <controls:IconChip
                                BackgroundColor="{DynamicResource AccentSoft}"
                                Diameter="40"
                                Glyph="{x:Static services:Icons.Fingerprint}"
                                IconColor="{DynamicResource AccentInk}" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label Text="指紋認証" />
                                <Label Style="{StaticResource Caption}" Text="起動するときに指紋で認証します" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding IsFingerprintEnabled}"
                                SemanticProperties.Description="指紋認証"
                                VerticalOptions="Center" />
                        </Grid>
                        <controls:DashedRule />
                        <Grid
                            x:Name="carryRow"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            MinimumHeightRequest="64">
                            <controls:IconChip
                                BackgroundColor="{DynamicResource AccentSoft}"
                                Diameter="40"
                                Glyph="{x:Static services:Icons.Carry}"
                                IconColor="{DynamicResource AccentInk}" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                Padding="0,8"
                                Spacing="2"
                                VerticalOptions="Center">
                                <Label Text="残りのお金を翌月に繰り越す" />
                                <Label Style="{StaticResource Caption}" Text="先月までに使い切らなかったお金を、今月使えるお金に加えます" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="{Binding RecordsTotalRemainingToThisMonth}"
                                SemanticProperties.Description="残りのお金を翌月に繰り越す"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!--  データ: バックアップの作成と復元  -->
                <Border Padding="20,8" Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <Label
                            Margin="0,10,0,2"
                            SemanticProperties.HeadingLevel="Level2"
                            Style="{StaticResource Heading}"
                            Text="データ" />
                        <controls:Pressable
                            x:Name="backupRow"
                            Command="{Binding CreateBackupCommand}"
                            CornerRadius="20"
                            Description="バックアップを作成"
                            Hint="ダブルタップで保存する場所を選ぶ">
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                MinimumHeightRequest="64">
                                <controls:IconChip
                                    BackgroundColor="{DynamicResource AccentSoft}"
                                    Diameter="40"
                                    Glyph="{x:Static services:Icons.Save}"
                                    IconColor="{DynamicResource AccentInk}" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="0,8"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label Text="バックアップを作成" />
                                    <Label Style="{StaticResource Caption}" Text="今の記録をすべて、1つのファイルに保存します" />
                                </VerticalStackLayout>
                                <controls:IconPath
                                    Grid.Column="2"
                                    Weight="2.4"
                                    Color="{DynamicResource Ink}"
                                    Glyph="{x:Static services:Icons.ChevronRight}"
                                    Size="14" />
                            </Grid>
                        </controls:Pressable>
                        <controls:DashedRule />
                        <controls:Pressable
                            x:Name="restoreRow"
                            Command="{Binding RestoreBackupCommand}"
                            CornerRadius="20"
                            Description="バックアップから復元"
                            Hint="ダブルタップでファイルを選ぶ">
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                MinimumHeightRequest="64">
                                <controls:IconChip
                                    BackgroundColor="{DynamicResource AccentSoft}"
                                    Diameter="40"
                                    Glyph="{x:Static services:Icons.Restore}"
                                    IconColor="{DynamicResource AccentInk}" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="0,8"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label Text="バックアップから復元" />
                                    <Label Style="{StaticResource Caption}" Text="保存したファイルの記録に置き換えます" />
                                </VerticalStackLayout>
                                <controls:IconPath
                                    Grid.Column="2"
                                    Weight="2.4"
                                    Color="{DynamicResource Ink}"
                                    Glyph="{x:Static services:Icons.ChevronRight}"
                                    Size="14" />
                            </Grid>
                        </controls:Pressable>
                    </VerticalStackLayout>
                </Border>

                <!--  使い方（すぐに使いはじめるための案内）と、くわしい使い方  -->
                <Border
                    x:Name="guideCard"
                    Padding="20,8"
                    Style="{StaticResource Card}">
                    <VerticalStackLayout>
                        <controls:Pressable
                            x:Name="guideRow"
                            Command="{Binding OpenGuideCommand}"
                            CornerRadius="20"
                            Description="使い方"
                            Hint="ダブルタップで使い方をひらく">
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                MinimumHeightRequest="64">
                                <controls:IconChip
                                    BackgroundColor="{DynamicResource AccentSoft}"
                                    Diameter="40"
                                    Glyph="{x:Static services:Icons.Help}"
                                    IconColor="{DynamicResource AccentInk}" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="0,8"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label Text="使い方" />
                                    <Label Style="{StaticResource Caption}" Text="すぐに使いはじめるための案内" />
                                </VerticalStackLayout>
                                <controls:IconPath
                                    Grid.Column="2"
                                    Weight="2.4"
                                    Color="{DynamicResource Ink}"
                                    Glyph="{x:Static services:Icons.ChevronRight}"
                                    Size="14" />
                            </Grid>
                        </controls:Pressable>
                        <controls:DashedRule />
                        <controls:Pressable
                            x:Name="detailRow"
                            Command="{Binding OpenDetailedGuideCommand}"
                            CornerRadius="20"
                            Description="くわしい使い方"
                            Hint="ダブルタップでくわしい使い方をひらく">
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="12"
                                MinimumHeightRequest="64">
                                <controls:IconChip
                                    BackgroundColor="{DynamicResource AccentSoft}"
                                    Diameter="40"
                                    Glyph="{x:Static services:Icons.List}"
                                    IconColor="{DynamicResource AccentInk}" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Padding="0,8"
                                    Spacing="2"
                                    VerticalOptions="Center">
                                    <Label Text="くわしい使い方" />
                                    <Label Style="{StaticResource Caption}" Text="予算、貯金の切り崩し、繰り越し" />
                                </VerticalStackLayout>
                                <controls:IconPath
                                    Grid.Column="2"
                                    Weight="2.4"
                                    Color="{DynamicResource Ink}"
                                    Glyph="{x:Static services:Icons.ChevronRight}"
                                    Size="14" />
                            </Grid>
                        </controls:Pressable>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Margin="4,0"
                    Style="{StaticResource Caption}"
                    Text="{Binding VersionText}" />

                <BoxView
                    x:Name="bottomSpace"
                    HeightRequest="120"
                    Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:FloatingTabBar Current="{x:Static controls:FloatingTabBar.SettingsRoute}" />

        <!--  ＋ つける, as on every tab  -->
        <controls:QuickAddButton x:Name="quickAdd" FabMargin="0,0,20,112" />
    </Grid>
</ContentPage>
