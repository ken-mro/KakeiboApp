<?xml version="1.0" encoding="utf-8" ?>
<!--  The sheet from the bottom for adding and editing (design: project/Sheet.dc.html).  -->
<toolkit:Popup
    x:Class="KakeiboApp.Views.Sheets.EntrySheet"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KakeiboApp.Views.Controls"
    xmlns:entries="clr-namespace:KakeiboApp.ViewModels.Entries"
    xmlns:services="clr-namespace:KakeiboApp.Services"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="entries:EntrySheetViewModel"
    Margin="0"
    Padding="0"
    BackgroundColor="{DynamicResource Surface}"
    HorizontalOptions="Fill"
    VerticalOptions="End">
    <Grid
        x:Name="root"
        SafeAreaEdges="All"
        Padding="20,12,20,24"
        RowDefinitions="Auto,Auto,Auto,Auto"
        VerticalOptions="End"
        RowSpacing="16">
        <!--  Grab handle  -->
        <BoxView
            CornerRadius="3"
            HeightRequest="5"
            HorizontalOptions="Center"
            WidthRequest="44"
            Color="{DynamicResource Rule}" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Title}"
                Text="{Binding Heading}"
                VerticalOptions="Center" />
            <controls:Pressable
                Grid.Column="1"
                Command="{Binding DismissCommand}"
                CornerRadius="22"
                Description="閉じる">
                <Border
                    BackgroundColor="{DynamicResource Paper}"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    WidthRequest="44">
                    <controls:IconPath
                        Weight="2.4"
                        Color="{DynamicResource InkMuted}"
                        Glyph="{x:Static services:Icons.Close}"
                        Size="18" />
                </Border>
            </controls:Pressable>
        </Grid>

        <!--
            One field after another, each a label over its box, in the order of the sheets before the redesign:
            日にち, 種類, 内容, 金額, どこから, メモ. A sheet shows only the fields its kind has.
        -->
        <ScrollView x:Name="scroll" Grid.Row="2" VerticalOptions="Start">
            <VerticalStackLayout Spacing="16">
                <!--  日にち: 今日・昨日 with one tap, any other day from the picker  -->
                <VerticalStackLayout IsVisible="{Binding ShowsDate}" Spacing="6">
                    <Label Style="{StaticResource LabelText}" Text="日にち" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource Field}">
                            <DatePicker
                                Date="{Binding Date}"
                                Format="yyyy/MM/dd"
                                MaximumDate="{x:Static entries:EntrySheetViewModel.MaximumDate}"
                                MinimumDate="{x:Static entries:EntrySheetViewModel.MinimumDate}"
                                SemanticProperties.Description="日にち" />
                        </Border>
                        <Button
                            Grid.Column="1"
                            Command="{Binding SetDayCommand}"
                            CommandParameter="0"
                            SemanticProperties.Description="今日にする"
                            Style="{StaticResource SmallOutlineButton}"
                            Text="今日">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsToday}"
                                    TargetType="Button"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Column="2"
                            Command="{Binding SetDayCommand}"
                            CommandParameter="1"
                            SemanticProperties.Description="昨日にする"
                            Style="{StaticResource SmallOutlineButton}"
                            Text="昨日">
                            <Button.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsYesterday}"
                                    TargetType="Button"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                    <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>

                <!--  種類  -->
                <VerticalStackLayout IsVisible="{Binding ShowsCategories}" Spacing="6">
                    <Label
                        SemanticProperties.HeadingLevel="Level2"
                        Style="{StaticResource LabelText}"
                        Text="種類" />
                    <!--  Three tiles a row; EntrySheet.xaml.cs places each tile as it is added.  -->
                    <Grid
                        x:Name="categoryGrid"
                        BindableLayout.ItemsSource="{Binding Categories}"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="entries:CategoryOption">
                                <controls:Pressable
                                    Command="{Binding Source={x:Reference root}, Path=BindingContext.SelectCategoryCommand, x:DataType=Grid}"
                                    CommandParameter="{Binding .}"
                                    CornerRadius="16"
                                    Description="{Binding Description}">
                                    <Border
                                        Padding="4,8"
                                        BackgroundColor="{DynamicResource Paper}"
                                        MinimumHeightRequest="64"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="2">
                                        <Border.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsSelected}"
                                                TargetType="Border"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
                                                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout
                                            HorizontalOptions="Fill"
                                            Spacing="4"
                                            VerticalOptions="Center">
                                            <controls:IconChip
                                                BackgroundColor="{Binding Style.Chip}"
                                                Diameter="28"
                                                Glyph="{Binding Style.Glyph}"
                                                HorizontalOptions="Center"
                                                IconColor="{Binding Style.Icon}"
                                                IconSize="16" />
                                            <Label
                                                FontSize="13"
                                                HorizontalTextAlignment="Center"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Name}">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding IsSelected}"
                                                        TargetType="Label"
                                                        Value="True">
                                                        <Setter Property="FontFamily" Value="ZenMaruBold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                </controls:Pressable>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </Grid>
                </VerticalStackLayout>

                <!--  内容  -->
                <VerticalStackLayout IsVisible="{Binding ShowsNameAndNote}" Spacing="6">
                    <Label Style="{StaticResource LabelText}" Text="内容" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            x:Name="nameEntry"
                            Placeholder="{Binding NamePlaceholder}"
                            ReturnType="Next"
                            SemanticProperties.Description="内容"
                            Text="{Binding Name}" />
                    </Border>
                </VerticalStackLayout>

                <!--  金額  -->
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource LabelText}" Text="{Binding AmountLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Label
                                FontFamily="ZenMaruBold"
                                FontSize="20"
                                Text="¥"
                                VerticalOptions="Center"
                                SemanticProperties.Description="円" />
                            <Entry
                                x:Name="amountEntry"
                                Grid.Column="1"
                                FontSize="26"
                                ReturnType="Done"
                                SemanticProperties.Description="{Binding AmountLabel}"
                                Style="{StaticResource AmountEntry}"
                                Text="{Binding AmountText}" />
                        </Grid>
                    </Border>
                    <Label
                        FontSize="14"
                        IsVisible="{Binding HasError}"
                        Text="{Binding ErrorText}"
                        TextColor="{DynamicResource DeficitInk}" />
                    <Label
                        IsVisible="{Binding HasHint}"
                        Style="{StaticResource Muted}"
                        Text="{Binding Hint}" />
                </VerticalStackLayout>

                <!--  どこから  -->
                <VerticalStackLayout IsVisible="{Binding ShowsFromWhere}" Spacing="6">
                    <Label Style="{StaticResource LabelText}" Text="どこから払った？" />
                    <Border Style="{StaticResource Field}">
                        <Entry
                            Placeholder="例：貯金"
                            SemanticProperties.Description="どこから払った？"
                            Text="{Binding FromWhere}" />
                    </Border>
                </VerticalStackLayout>

                <!--  メモ: several lines, as typed; the box grows with the text  -->
                <VerticalStackLayout IsVisible="{Binding ShowsNameAndNote}" Spacing="6">
                    <Label Style="{StaticResource LabelText}" Text="メモ" />
                    <Border Padding="10,4" Style="{StaticResource Field}">
                        <Editor
                            AutoSize="TextChanges"
                            MinimumHeightRequest="72"
                            Placeholder="改行して書けます（なくてもOK）"
                            SemanticProperties.Description="メモ"
                            Text="{Binding Note}" />
                    </Border>
                </VerticalStackLayout>

                <Label
                    FontSize="14"
                    IsVisible="{Binding HasSavedText}"
                    Text="{Binding SavedText}"
                    TextColor="{DynamicResource AccentInk}" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  Buttons within thumb reach  -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,*"
            ColumnSpacing="12">
            <Button
                Command="{Binding SaveAndContinueCommand}"
                IsVisible="{Binding CanContinue}"
                Style="{StaticResource OutlineButton}"
                Text="つづけて登録" />
            <Button
                Command="{Binding DeleteCommand}"
                IsVisible="{Binding CanDelete}"
                Style="{StaticResource DeleteButton}"
                Text="けす" />
            <Button
                x:Name="saveButton"
                Grid.Column="1"
                Command="{Binding SaveCommand}"
                Text="{Binding SaveText}">
                <Button.Shadow>
                    <Shadow
                        Brush="{StaticResource ShadowLavender}"
                        Opacity="0.30"
                        Radius="20"
                        Offset="0,8" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>
</toolkit:Popup>
